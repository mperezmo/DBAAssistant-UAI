# Copiar a .env y completar. El archivo .env nunca se versiona.

# --- Aplicación ---
APP_ENTORNO=desarrollo
LOG_NIVEL=INFO

# --- SQL Server (base propia de la app) ---
SQLSERVER_HOST=sqlserver
SQLSERVER_PUERTO=1433
SQLSERVER_PREFIJO_BASE=DBAAssistant
SQLSERVER_USUARIO=sa

# --- MongoDB ---
MONGODB_PREFIJO_BASE=dba_assistant

# --- Redis: TTL de caché en segundos ---
REDIS_URL=redis://redis:6379/0
CACHE_TTL_IA=86400
CACHE_TTL_CONTEXTO=600
CACHE_TTL_METRICAS=30

# --- Notificaciones push (Web Push / VAPID) ---
# Generar con: docker compose run --rm backend python -m app.cli generar-vapid
VAPID_CLAVE_PUBLICA=
VAPID_CONTACTO=mailto:

# --- Correo saliente (SMTP) para notificar alertas ---
# Gmail: smtp.gmail.com, puerto 587, usuario = la cuenta y SECRETO_SMTP_PASSWORD =
# una "contraseña de aplicación" (requiere verificación en dos pasos en la cuenta).
# Probar con: docker compose exec backend python -m app.cli probar-correo --para <email>
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_REMITENTE=
SMTP_STARTTLS=true

# --- Sandbox ---
SANDBOX_URL=http://sandbox:8100

# --- Monitoreo ---
MONITOR_RECOLECTOR_ACTIVO=true
MONITOR_INTERVALO_SEGUNDOS=3
MONITOR_RETENCION_DIAS=30

# --- Identidad (Auth0) — ver docs/auth0.md ---
# Cada empresa entra por https://<slug>.<DOMINIO_BASE>
DOMINIO_BASE=localhost
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api.dba-assistant
AUTH0_ADMIN_CLIENT_ID=

# --- IA generativa (Chat IA) ---
# La clave de la API va en SECRETO_ANTHROPIC_API_KEY (console.anthropic.com).
IA_MODELO=claude-haiku-5-5
# Esfuerzo de razonamiento: low (más rápido), medium o high.
IA_ESFUERZO=low
# Filas que muestra un SELECT del chat (el CSV exporta todas) y tiempo máximo por consulta.
CHAT_FILAS_PANTALLA=1000
CHAT_TIMEOUT_CONSULTA_SEGUNDOS=60

# --- Secretos (al migrar a Azure pasan a Key Vault) ---
# Contraseña de SA: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
SECRETO_SQLSERVER_PASSWORD=
SECRETO_MONGODB_URI=mongodb://mongo:27017
SECRETO_ANTHROPIC_API_KEY=
# Clave maestra para cifrar las credenciales de las conexiones. Generarla con:
#   docker compose run --rm backend python -m app.cli generar-clave
# Si se pierde, hay que volver a cargar las contraseñas de todas las conexiones.
SECRETO_CLAVE_CIFRADO=
SECRETO_AUTH0_CLIENT_SECRET=
SECRETO_AUTH0_ADMIN_CLIENT_SECRET=
# Clave privada VAPID de las notificaciones push (ver generar-vapid más arriba).
SECRETO_VAPID_CLAVE_PRIVADA=
# Contraseña del servidor SMTP (ver la sección de correo saliente).
SECRETO_SMTP_PASSWORD=
# Token compartido entre el backend y el servicio Sandbox (cadena aleatoria larga).
SECRETO_SANDBOX_TOKEN=
# Contraseña de SA de los SQL Server del Sandbox (misma política que la de SA).
SECRETO_SANDBOX_SA_PASSWORD=
